# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Source it with: set -a; source .env; set +a

# Hugging Face access token (read) for gated pyannote models used by WhisperX diarization.
# Create at https://huggingface.co/settings/tokens and accept the model terms first.
export HF_TOKEN=
export HUGGING_FACE_HUB_TOKEN=
export PYANNOTE_AUTH_TOKEN=

# Optional (Linux + CUDA only): path to the cuDNN libraries inside your virtualenv.
# export LD_LIBRARY_PATH=/path/to/.venv/lib/python3.x/site-packages/nvidia/cudnn/lib

# Optional: Ollama endpoint used for translation/correction.
# export OLLAMA_URL=http://127.0.0.1:11434
